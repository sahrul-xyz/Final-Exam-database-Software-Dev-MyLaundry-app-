# Supabase Configuration for MyLaundry Mobile App
# Gunakan alamat IP mesin host jika menguji via physical device Android/Expo Go (misal: http://192.168.1.X:54321)
# Atau gunakan http://10.0.2.2:54321 jika menggunakan Android Emulator
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
